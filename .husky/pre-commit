#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

run_pnpm() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm "$@"
  elif command -v pnpm.cmd >/dev/null 2>&1; then
    pnpm.cmd "$@"
  elif command -v corepack.cmd >/dev/null 2>&1; then
    corepack.cmd pnpm "$@"
  elif command -v corepack >/dev/null 2>&1; then
    corepack pnpm "$@"
  else
    echo "pnpm not found. Install pnpm or enable Corepack before committing." >&2
    exit 127
  fi
}

# 生成版本号
run_pnpm gen:version

# 自动添加修改的版本文件
git add src/lib/version.ts
git add VERSION.txt

run_pnpm exec lint-staged
